# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# IMPORTANT: Whitelist IP 0.0.0.0/0 in MongoDB Atlas -> Network Access -> IP Access List
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/xentrox_labs?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Environment (development | production)
NODE_ENV=development

# Optional: Allowed Frontend Origins (Comma separated for multiple, or * for all)
# Example: CLIENT_URL=http://localhost:5173,https://xentrox-labs.vercel.app
CLIENT_URL=*
