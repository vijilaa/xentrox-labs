{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://xentrox-labs-sever.vercel.app/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://xentrox-labs-sever.vercel.app/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
